  >
    <div
      class="card-header inspection-general-evidence-card-header d-flex flex-wrap justify-content-between align-items-center gap-2"
    >
      <div
        class="fw-semibold"
      >
        Additional report evidence
      </div>
      <div
        class="d-flex align-items-center gap-2"
      >
        <button
          aria-label="Take photo"
          class="btn btn-primary btn-sm d-inline-flex align-items-center px-3  inspection-take-photo-btn px-2 px-sm-2"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-camera me-0 me-sm-1 align-text-bottom"
            fill="none"
            height="13"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="13"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"
            />
            <circle
              cx="12"
              cy="13"
              r="3"
            />
          </svg>
          <span
            class="d-none d-sm-inline"
          >
            Take photo
          </span>
        </button>
        <button
          aria-label="Upload photo"
          class="btn btn-sm text-primary px-2 py-1 border-0 bg-transparent shadow-none  px-2 px-sm-2"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-upload me-0 me-sm-1 align-text-bottom"
            fill="none"
            height="13"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="13"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12 3v12"
            />
            <path
              d="m17 8-5-5-5 5"
            />
            <path
              d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
            />
          </svg>
          <span
            class="d-none d-sm-inline"
          >
            Upload photo
          </span>
        </button>
      </div>
    </div>
    <div
      class="card-body inspection-general-evidence-card-body d-grid gap-3"
    >
      <div
        class="small text-body-secondary"
      >
        Optional. Use this only for photos or remarks that apply to the whole inspection/location, not a specific finding or equipment item.
      </div>
      <div
        class="d-grid gap-1"
      >
        <label
          class="form-label small fw-semibold text-muted mb-0"
        >
          Additional report remarks
        </label>
        <textarea
          aria-label="Additional report remarks"
          class="form-control"
          maxlength="2000"
          placeholder="Optional remarks for the whole inspection/location."
          rows="3"
        />
      </div>
      <div
        class="text-body-secondary"
      >
        No additional report photos added.
      </div>
    </div>
  </div>
  <div
    class="d-grid gap-2 d-none d-md-grid"
  >
    <div
      class="inspection-form-actions d-flex flex-column flex-sm-row justify-content-end gap-2"
    >
      <div
        class="inspection-draft-status small text-body-secondary me-sm-auto align-self-sm-center"
      >
        Complete required inspection items before review.
      </div>
      <button
        class="btn btn-outline-secondary"
        type="button"
      >
        Save Draft
      </button>
    </div>
  </div>
  <div
    class="d-grid gap-2 d-md-none"
  >
    <div
      aria-label="Form actions"
      class="action-row-thumb action-row-thumb--compact-sticky inspection-form-inline-actions"
      role="group"
    >
      <div
        class="action-row-thumb-actions"
      >
        <button
          class="btn btn-outline-secondary inspection-form-sticky-draft-btn"
          type="button"
        >
          Save Draft
        </button>
      </div>
    </div>
    <div
      class="action-row-thumb-spacer action-row-thumb-spacer--compact inspection-form-inline-actions-spacer d-md-none"
    />
  </div>
</div>
`;

