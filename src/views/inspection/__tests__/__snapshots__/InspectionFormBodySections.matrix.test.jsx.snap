    </div>
    <div
      class="card-body inspection-general-evidence-card-body d-grid gap-3"
    >
      <div
        class="small text-body-secondary"
      >
        Optional. Use this only for photos or remarks that apply to the whole inspection/location, not a specific finding or equipment item.
      </div>
      <div
        class="d-grid gap-1"
      >
        <label
          class="form-label small fw-semibold text-muted mb-0"
        >
          Additional report remarks
        </label>
        <textarea
          aria-label="Additional report remarks"
          class="form-control"
          maxlength="2000"
          placeholder="Optional remarks for the whole inspection/location."
          rows="3"
        />
      </div>
      <div
        style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.75rem;"
      >
        <div
          class="rounded-3 border border-light-subtle p-2 d-grid gap-2"
        >
          <div
            class="workflow-photo-preview"
          >
            <img
              alt="Inspection photo"
              class="workflow-photo-preview__image"
              decoding="async"
              loading="lazy"
              src="data:image/png;base64,AA=="
            />
          </div>
          <div
            class="small text-truncate"
          >
            Photo
          </div>
          <div
            class="d-grid gap-2"
          >
            <input
              aria-label="Photo description"
              class="form-control form-control-sm"
              placeholder="Describe this photo"
              type="text"
              value=""
            />
          </div>
          <button
            class="btn btn-outline-danger btn-sm d-inline-flex align-items-center justify-content-center gap-1"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-trash2 lucide-trash-2"
              fill="none"
              height="14"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="14"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M10 11v6"
              />
              <path
                d="M14 11v6"
              />
