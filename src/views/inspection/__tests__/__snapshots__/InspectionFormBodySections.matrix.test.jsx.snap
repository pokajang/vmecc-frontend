       section
    </div>
  </div>
  <div
    class="inspection-general-evidence-section inspection-evidence--inline d-grid gap-3"
  >
    <div
      class="flex-wrap justify-content-between align-items-center gap-2 d-flex"
    >
      <div
        class="fw-semibold"
      >
        General photos and remarks
      </div>
      <div
        class="d-flex align-items-center gap-2"
      >
        <button
          aria-label="Take photo"
          class="btn btn-outline-primary btn-sm create-action-button create-action-button--section-primary d-inline-flex align-items-center px-3  inspection-take-photo-btn px-2 px-sm-2"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-camera me-0 me-sm-1 align-text-bottom"
            fill="none"
            height="13"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="13"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"
            />
            <circle
              cx="12"
              cy="13"
              r="3"
            />
          </svg>
          <span
            class="d-none d-sm-inline"
          >
            Take photo
          </span>
        </button>
        <button
          aria-label="Upload photo"
          class="btn btn-sm create-action-button create-action-button--inline text-primary px-2 py-1 border-0 bg-transparent shadow-none  px-2 px-sm-2"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-upload me-0 me-sm-1 align-text-bottom"
            fill="none"
            height="13"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="13"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12 3v12"
            />
            <path
              d="m17 8-5-5-5 5"
            />
            <path
              d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
