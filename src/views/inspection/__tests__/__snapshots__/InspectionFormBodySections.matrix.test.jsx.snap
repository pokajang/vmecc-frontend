exports[`InspectionFormBodySections cross-form in-form state snapshots > 'complete-with-next-location' state visual baseline for 'ER Aux Equipment Inspection' ['desktop'] > /desktop/er-aux-equipment-inspection/complete-with-next-location 1`] = `
<div>
  <div
    aria-label="Emergency Response Auxiliary Equipment checklist"
    class="inspection-form-section inspection-form-body-start d-grid gap-3"
    tabindex="-1"
  >
    <div
      data-testid="structured-section"
    >
      ER Aux Equipment Inspection
       section
    </div>
  </div>
  <div
    class="inspection-general-evidence-section inspection-evidence--inline d-grid gap-3"
  >
    <div
      class="flex-wrap justify-content-between align-items-center gap-2 d-flex"
    >
      <div
        class="fw-semibold"
      >
        General photos and remarks
      </div>
      <div
        class="d-flex align-items-center gap-2"
      >
        <button
          aria-label="Take photo"
          class="btn btn-outline-primary btn-sm create-action-button create-action-button--section-primary d-inline-flex align-items-center px-3  inspection-take-photo-btn px-2 px-sm-2"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-camera me-0 me-sm-1 align-text-bottom"
            fill="none"
            height="13"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="13"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"
            />
            <circle
              cx="12"
              cy="13"
              r="3"
            />
          </svg>
          <span
            class="d-none d-sm-inline"
          >
            Take photo
          </span>
        </button>
        <button
          aria-label="Upload photo"
          class="btn btn-sm create-action-button create-action-button--inline text-primary px-2 py-1 border-0 bg-transparent shadow-none  px-2 px-sm-2"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-upload me-0 me-sm-1 align-text-bottom"
            fill="none"
            height="13"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="13"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M12 3v12"
            />
            <path
              d="m17 8-5-5-5 5"
            />
            <path
              d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
            />
          </svg>
          <span
            class="d-none d-sm-inline"
          >
            Upload photo
          </span>
        </button>
      </div>
    </div>
    <div
      class="d-grid gap-3"
    >
      <div
        class="small text-body-secondary"
      >
        These photos apply to the inspection as a whole and will appear in the General photos and remarks section of the report. Add issue-specific photos to the relevant finding or equipment item instead.
      </div>
      <div
        class="d-grid gap-1"
      >
        <label
          class="form-label small fw-semibold text-muted mb-0"
        >
          General report remarks (optional)
        </label>
        <textarea
          aria-label="General report remarks (optional)"
          class="form-control"
          maxlength="2000"
          placeholder="Optional remarks that apply to the inspection as a whole."
          rows="3"
        />
      </div>
      <div
        style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.75rem;"
      >
        <div
          class="rounded-3 border border-light-subtle p-2 d-grid gap-2"
        >
          <div
            class="workflow-photo-preview workflow-photo-preview--uncropped"
          >
            <img
              alt="Inspection photo"
              class="workflow-photo-preview__image"
              decoding="async"
              loading="lazy"
              src="data:image/png;base64,AA=="
            />
          </div>
          <div
            class="small text-truncate"
          >
            Photo
          </div>
          <div
            class="d-grid gap-2"
          >
            <textarea
              aria-label="Photo description"
              class="form-control"
              placeholder="Describe this photo"
              rows="2"
            />
          </div>
          <button
            class="btn btn-outline-danger btn-sm d-inline-flex align-items-center justify-content-center gap-1"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-trash2 lucide-trash-2"
              fill="none"
              height="14"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="14"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M10 11v6"
              />
              <path
                d="M14 11v6"
              />
              <path
                d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"
              />
              <path
                d="M3 6h18"
              />
              <path
                d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
              />
            </svg>
            Remove
          </button>
        </div>
      </div>
    </div>
  </div>
  <div
    class="inspection-next-location-card rounded-3 border bg-light-subtle p-3 d-grid gap-2"
  >
    <div
      class="small fw-semibold text-body-secondary"
    >
      Next location
    </div>
    <div
      class="inspection-next-location-options d-flex flex-wrap gap-2"
    >
      <button
        class="btn btn-outline-primary inspection-next-location-btn"
        type="button"
      >
        Office
      </button>
    </div>
  </div>
  <div
    class="d-grid gap-2 d-none d-md-grid"
  >
    <div
      class="workflow-stage-actions"
    >
      <div
        aria-label="Inspection form actions"
        class="action-row-thumb action-row-thumb--in-flow workflow-stage-actions__group"
        role="group"
      >
        <div
          class="action-row-thumb-actions"
        >
          <button
            class="btn btn-primary"
            type="button"
          >
            Continue to Review
          </button>
        </div>
      </div>
    </div>
  </div>
  <div
    class="d-grid gap-2 d-md-none"
  >
    <div
      class="workflow-stage-actions"
    >
      <div
        aria-label="Inspection form actions"
        class="action-row-thumb action-row-thumb--compact-sticky workflow-stage-actions__group"
        role="group"
      >
        <div
          class="action-row-thumb-actions"
        >
          <button
            class="btn btn-primary"
            type="button"
          >
            Continue to Review
          </button>
        </div>
      </div>
      <div
        class="action-row-thumb-spacer action-row-thumb-spacer--compact d-md-none"
      />
    </div>
  </div>
</div>
`;

